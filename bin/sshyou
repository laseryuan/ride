#!/usr/bin/env bash

if_debug() {
  [ $is_debug_mode ] && {
    echo "echo"
  }
}

usage() {
  cat <<'EOF'
Usage: sshyou [options] [user@]server

Connect to a remote device by relaying through the sish jump host
(sish.unsown.top), with the desktop VNC port and an ssh port forwarded.

Options:
  -L, --local <spec>   Extra -L forward passed to ssh (e.g. :3000:localhost:3000)
  -R, --remote <spec>  Extra -R forward passed to ssh
  --ssh <opt>          Pass an extra option through to the underlying ssh command

  Any "~" in <spec>/<opt> above is expanded to $HOME, since quoting the
  value as one argument otherwise prevents the shell from doing that itself.
  --mount              Restart sshstart in mount mode and forward its ssh port
  --debug              Print the ssh command instead of executing it
  -h, --help           Show this help message and exit

Arguments:
  [user@]server  Target to connect to. Defaults to user "ride" when no
                 user is given.
EOF
}

main() {
  local SSH_FORWARD_PORT=12322

  local ssh_option
  local is_debug_mode
  local mount_flag

  while [[ "$#" -gt 0 ]]; do
    case $1 in
        -L|--local) ssh_option+=" -L ${2//\~/$HOME} "; shift ;;
        -R|--remote) ssh_option+=" -R ${2//\~/$HOME} "; shift ;;
        --ssh) ssh_option+=" ${2//\~/$HOME} "; shift ;;
        --mount) mount_flag=0 ;;
        --debug) is_debug_mode=0 ;;
        -h|--help) usage; exit 0 ;;
        *) break ;;
    esac
    shift
  done

  first=$1
  arrIN=(${first//@/ })
  if [ -z "${arrIN[1]}"  ]; then
    USER=ride
    SSHME_SERVER=${arrIN[0]}
  else
    USER=${arrIN[0]}
    SSHME_SERVER=${arrIN[1]}
  fi

  shift

  if [ $mount_flag ]; then
    sshstart --restart mount

    ssh_option+=" -R ${SSH_FORWARD_PORT}:localhost:22 "
  fi

  $(if_debug) ssh \
    -L 0.0.0.0:5900:desktop:5900 \
    -L 0.0.0.0:${SSH_FORWARD_PORT}:localhost:22 \
    -J sish.unsown.top:22222 \
    ${ssh_option} \
    ${USER}@${SSHME_SERVER}
}

test (){
  function ssh {
    echo "calling: ssh $@"
  }
  function sshstart {
    echo "calling: sshstart $@"
  }

  if [[ $(main -L :3000:localhost:3000 ride@shell) != "calling: ssh -L 0.0.0.0:5900:desktop:5900 -L 0.0.0.0:12322:localhost:22 -J sish.unsown.top:22222 -L :3000:localhost:3000 ride@shell" ]]; then
    echo "TEST FAILURE: -L"
    exit 1
  fi

  local res=$(main --mount ride@shell)
  if ! [[ 
    $res =~ "calling: sshstart --restart mount"
      &&
    $res =~ "calling: ssh -L 0.0.0.0:5900:desktop:5900 -L 0.0.0.0:12322:localhost:22 -J sish.unsown.top:22222 -R 12322:localhost:22 ride@shell"
    ]]; then
    echo "TEST FAILURE: --mount"
    exit 1
  fi

  echo TESTS succeed!
}

if [[ "$1" = "test" ]]; then
  test
else
  main "$@"
fi
