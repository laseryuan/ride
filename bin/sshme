#!/bin/bash

# The bash script file bin/sshme below has features:
# * It works with sshstart:
#
# Please add this features:
# * can load key from github by given option --key name
#
#  bin/sshstart:
#  {{bin/sshstart}}
#

#  bin/sshme:

#!/bin/bash

usage() {
  cat <<'EOF'
Usage: sshme [mount] [--key <name>] [user@server]

Connect to a device through the sish relay server. Runs sshstart first,
then opens a reverse SSH tunnel to the target so it can be reached as
[user@]server (the local ssh port is forwarded to the sish server).

Options:
  mount         Pass --mount to sshstart before connecting
  --key <name>  Pass --key <name> to sshstart to load a key from GitHub
  -h, --help    Show this help message and exit

Arguments:
  [user@]server  Target to register with sish. "user" becomes the remote
                 forward name (ssh -R <user>:22:localhost:22) and "server"
                 selects <server>.unsown.top. Defaults to "@sish" (empty
                 forward name, server "sish").
EOF
}

mount_flag=""
key_option=""

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    mount) mount_flag="--mount" ;;
    --key) key_option="--key $2"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) break ;;
  esac
  shift
done

sshstart $mount_flag $key_option

first=$1
first=${first:-@sish}

input=$first
sep='@'
case $input in
  (*"$sep"*)
    before=${input%%"$sep"*}
    after=${input#*"$sep"}
    ;;
  (*)
    before=$input
    after=
    ;;
esac

SSH_USER=$before
SSH_SERVER=${after:-sish}

# connect to sish server as target
ssh -o StrictHostKeyChecking=no -p 22222 -R "$SSH_USER":22:localhost:22 $SSH_SERVER.unsown.top

