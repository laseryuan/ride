#!/usr/bin/env bash

if_debug() {
  [ $is_debug_mode ] && {
    echo "echo"
  }
}

get_host_name() {
    if getent hosts host.docker.internal > /dev/null; then
        host_name=host.docker.internal
    else
        host_name=$HOST_NAME
    fi
}

usage() {
  cat <<'EOF'
Usage: sshhost [options] [-- ] [command...]

Connect to the host machine over SSH. The target is
"$HOST_USER_NAME"@"$HOST_NAME", or "$HOST_USER_NAME"@host.docker.internal
when that name resolves (e.g. from inside a container).

Options:
  --ssh <opt>   Pass an extra option through to the underlying ssh command
                (may be given multiple times). Any "~" in <opt> is expanded
                to $HOME, since quoting <opt> as one argument otherwise
                prevents the shell from doing that itself.
  --debug       Print the ssh command instead of executing it
  -h, --help    Show this help message and exit

If a command (and optional arguments) is given after the options, it is
run on the host non-interactively instead of starting a login shell.
EOF
}

main() {
    local is_debug_mode
    local host_name
    local ssh_option

    while [[ "$#" -gt 0 ]]; do
        case $1 in
            --ssh) ssh_option+=" ${2//\~/$HOME} "; shift ;;
            --debug) is_debug_mode=0 ;;
            -h|--help) usage; exit 0 ;;
            *) break ;;
        esac
        shift
    done

    get_host_name

    $(if_debug) ssh \
        ${ssh_option} \
        "$HOST_USER_NAME"@"$host_name" \
        "$@"
}

main "$@"
